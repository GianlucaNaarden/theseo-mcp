/**
 * Configuratie voor de theseo-mcp Worker.
 * Documentatie: https://developers.cloudflare.com/workers/wrangler/configuration/
 *
 * Deze server heeft geen secrets nodig: hij praat alleen met de publieke
 * API-endpoints van de TheSEO site-Worker. De GOOGLE_PLACES_API_KEY voor de
 * vindbaarheidscheck leeft op DIE Worker, niet hier.
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "theseo-mcp",
	"main": "src/index.ts",
	"compatibility_date": "2026-07-02",
	"compatibility_flags": ["nodejs_compat"],
	// Privacyarme gebruikstelling. Elk punt bevat uitsluitend de toolnaam als
	// index, de UTC-dag als blob en het getal 1. Invoer, headers, IP-adressen en
	// gesprekstekst worden niet naar deze dataset geschreven.
	"analytics_engine_datasets": [
		{
			"binding": "MCP_USAGE",
			"dataset": "theseo_mcp_tool_usage"
		}
	],
	// Rechtstreekse route naar de site-Worker. Een gewone fetch naar de
	// workers.dev URL van diezelfde account belandt bij de statische bestanden
	// en geeft dus 404 op /api/scan; via deze binding komt het verzoek bij het
	// script terecht.
	"services": [
		{
			"binding": "SITE_WORKER",
			"service": "theseo-site"
		}
	],
	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"invocation_logs": false
		},
		"traces": {
			"enabled": false
		}
	}
}
